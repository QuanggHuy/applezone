@model IEnumerable<AppleZone.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng (Nhân viên)";
}

<h1>Tất cả đơn hàng</h1>

@if (!Model.Any())
{
    <p>Chưa có đơn hàng nào trong hệ thống.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th style="text-align:right;">Tổng tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var order in Model)
{
        <tr>
            <td>#@order.Id</td>
            <td>@order.Customer?.Email</td>
            <td>@order.Date.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@order.Status</td>
            <td style="text-align:right;">@order.OrderDetails.Sum(od => od.Quantity * od.Price * (1 - od.Discount)).ToString("C2")</td>
            <td><a asp-action="OrderDetail" asp-route-id="@order.Id">Xem chi tiết</a></td>
        </tr>
}
        </tbody>
    </table>
}

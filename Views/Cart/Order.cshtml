@model AppleZone.Helper.Cart

@{
    ViewData["Title"] = "Your Order";
}

<h1>Your Order</h1>
<hr>

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <strong>Đặt hàng thất bại:</strong> @ViewData["ErrorMessage"]
        <br /><a asp-controller="Cart" asp-action="Index">Quay lại giỏ hàng</a>
    </div>
}
else if (ViewData["OrderId"] != null)
{
    <div class="alert alert-success">
        Đặt hàng thành công! Mã đơn hàng: <strong>#@ViewData["OrderId"]</strong>
    </div>
}

Date: @(DateTime.Today.ToString("MM/dd/yyyy"))<br/>
Customer: @User.Identity?.Name

<table class="table">
    <thead>
        <tr>
            <th>
                Image
            </th>
            <th>
                Name
            </th>
            <th>
                Category
            </th>
            <th style="text-align:right;">
                Quantity
            </th>
            <th style="text-align:right;">
                Old Price
            </th>
            <th style="text-align:right;">
                Discount
            </th>
            <th style="text-align:right;">
                New Price
            </th>
            <th style="text-align:right;">
                Amount
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.List.Values)
        {
            <tr>
                <td><img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)" onerror="this.onerror=null;this.src='/images/no-image.svg';" width="150" /></td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category)
                </td>
                <td style="text-align:right;">
                    @item.Quantity
                </td>
                <td style="text-align:right;">
                    @item.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </td>
                <td style="text-align:right;">
                    @item.Discount.ToString("P0")
                </td>
                <td style="text-align:right;">
                    @item.NewPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </td>
                <td style="text-align:right;">
                    @item.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="7" style="text-align:right;">Total:</th>
            <th style="text-align:right;">@Model.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</th>
        </tr>
    </tfoot>
</table>
@if (ViewData["OrderId"] != null)
{
    <h2>Thank you for your order!</h2>
}
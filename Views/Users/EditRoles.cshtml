@model AppleZone.Models.Account.EditUserRolesViewModel

@{
    ViewData["Title"] = "Sửa quyền";
}

<h1>Sửa quyền: @Model.Email</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />

    @for (int i = 0; i < Model.Roles.Count; i++)
    {
        <div class="form-check">
            <input type="hidden" asp-for="Roles[i].RoleName" />
            <input type="checkbox" asp-for="Roles[i].IsSelected" class="form-check-input" />
            <label class="form-check-label" asp-for="Roles[i].IsSelected">@Model.Roles[i].RoleName</label>
        </div>
    }

    <div style="margin-top: 15px;">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>
